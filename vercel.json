{
  "crons": [
    {
      "path": "/api/cron/fetch-prices",
      "schedule": "15 7 * * 1-5"
    },
    {
      "path": "/api/cron/generate-recommendations",
      "schedule": "30 7 * * 1-5"
    }
  ],
  "functions": {
    "api/cron/fetch-prices.js": {
      "maxDuration": 60
    },
    "api/cron/generate-recommendations.js": {
      "maxDuration": 60
    },
    "api/trigger-cron.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
